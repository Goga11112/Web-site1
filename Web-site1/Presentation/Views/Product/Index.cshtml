@model IEnumerable<Web_site1.Domain.Entities.Product>
@{
    ViewData["Title"] = "Товары";
    var userRank = (UserRank)ViewBag.UserRank;
}

<h1>Товары</h1>

<form asp-action="Index" method="get">
</form>
<p>
    <a asp-action="Create" class="btn btn-primary">Создать</a>

</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <img src="@item.ProductImageUrl" class="card-img-top" alt="@item.Name">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>

                    @{
                        decimal discountedPrice = item.Price;
                        switch (userRank)
                        {
                            case UserRank.Bronze:
                                discountedPrice = item.Price * 1m;
                                break;
                            case UserRank.Silver:
                                discountedPrice = item.Price * 0.90m;
                                break;
                            case UserRank.Gold:
                                discountedPrice = item.Price * 0.85m;
                                break;
                        }
                    }

                    <p class="card-text">Цена: @(item.Price.ToString("C"))</p>
                    <p class="card-text">Цена со скидкой: @(discountedPrice.ToString("C"))</p>



                    <div class="d-flex justify-content-between align-items-center">
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Редактировать</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Удалить</a>

                            <div id="add-to-cart-message-@item.Id"></div> 
                            <form asp-controller="Basket" asp-action="AddToCart" method="post" id="add-to-cart-form-@item.Id">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="number" name="quantity" value="1" min="1" class="form-control-sm w-25" /> @* Поле для количества *@
                                <button type="button" class="btn btn-primary btn-sm" onclick="addToCart(@item.Id)">В корзину</button>
                            </form>

                        </div>
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<script>
    function addToCart(productId) {
        var form = $('#add-to-cart-form-' + productId);
        var quantity = form.find('input[name="quantity"]').val();
        var token = form.find('input[name="__RequestVerificationToken"]').val();

        console.log('#add-to-cart-form-' + productId + ' input[name="quantity"]');
        console.log({ productId: productId, quantity: quantity, __RequestVerificationToken: token });

        $.ajax({
            type: "POST",
            url: "@Url.Action("AddToCart", "Basket")",
            data: {
                productId: productId,
                quantity: quantity,
                __RequestVerificationToken: token
            },
            success: function (result) { // Один обработчик success
                if (result.success) {
                    $("#add-to-cart-form-" + productId).append("<span class='text-success ml-2'>" + result.message + "</span>");
                    $("#add-to-cart-message-" + productId).append("<div class='alert alert-success' role='alert'>" + result.message + "</div>");
                } else {
                    $("#add-to-cart-message-" + productId).append("<div class='alert alert-danger' role='alert'>Ошибка при добавлении товара в корзину.</div>");
                }
            },
            error: function (error) {
                console.error(error);
                $("#add-to-cart-message-" + productId).append("<div class='alert alert-danger' role='alert'>Ошибка при добавлении товара в корзину.</div>");
            }
        });
    } // Удалена лишняя }
</script>